{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAI Gallery",
  "version": "0.2.0",
  "identifier": "com.pc.nai-gallery",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NAI Gallery",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCREMzQURBOTc0MjQ1MkYKUldRdlJVS1gyanJjNndQTHZ4TjVreEFTRUJTRFJWeEY4bUhKb0dwMDBBRjU2Y3dyMkZuMjM4QXoK",
      "endpoints": [
        "https://github.com/anootoko-ai/nai-gallery/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
